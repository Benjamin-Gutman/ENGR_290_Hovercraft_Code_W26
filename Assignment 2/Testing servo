#include <avr/io.h>
#include <stdint.h>

#define SERVO_MIN_ANGLE   (-85)
#define SERVO_MAX_ANGLE   (85)

#define SERVO_MIN_OCR     2000
#define SERVO_CENTER_OCR  3000
#define SERVO_MAX_OCR     4000

static int16_t force_yaw(int16_t yaw)
{
    if (yaw > SERVO_MAX_ANGLE) return SERVO_MAX_ANGLE;
    if (yaw < SERVO_MIN_ANGLE) return SERVO_MIN_ANGLE;
    return yaw;
}

void timer1_servo_init(void)
{
    DDRB |= (1 << PB1);

    TCCR1A = 0;
    TCCR1B = 0;

    TCCR1A |= (1 << COM1A1);
    TCCR1A |= (1 << WGM11);
    TCCR1B |= (1 << WGM13) | (1 << WGM12);

    TCCR1B |= (1 << CS11);

    ICR1 = 40000;
    OCR1A = SERVO_CENTER_OCR;
}

void servo_set_from_yaw(int16_t yaw_deg)
{
    int16_t yaw_forced;
    int32_t ocr;

    yaw_forced = force_yaw(yaw_deg);

    ocr = SERVO_MIN_OCR;
    ocr += ((int32_t)(yaw_forced + 85) * (SERVO_MAX_OCR - SERVO_MIN_OCR)) / 170;

    OCR1A = (uint16_t)ocr;
}

int main(void)
{
    int16_t yaw_deg = 0;

    timer1_servo_init();

    while (1)
    {
        servo_set_from_yaw(yaw_deg);
    }
}
